{
  "description": "Restores the validated-memory --harness-memory symlink for adopter projects on every session start.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/restore-memory-symlink.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
